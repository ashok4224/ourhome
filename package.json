{
  "name": "ourhome",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "concurrently -n auth,properties,appointments,inquiries,favorites,support,chat,gateway -c blue,green,yellow,magenta,cyan,white,red,gray \"tsx watch services/auth-service/src/index.ts\" \"tsx watch services/properties-service/src/index.ts\" \"tsx watch services/appointments-service/src/index.ts\" \"tsx watch services/inquiries-service/src/index.ts\" \"tsx watch services/favorites-service/src/index.ts\" \"tsx watch services/support-service/src/index.ts\" \"tsx watch services/chat-service/src/index.ts\" \"tsx watch services/gateway/src/index.ts\"",
    "build": "vite build",
    "build:services": "npm run build --workspaces --if-present",
    "preview": "vite preview",
    "clean": "rm -rf dist services/*/dist",
    "lint": "tsc --noEmit && npm run lint --workspaces --if-present",
    "test": "node scripts/run-tests.js",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "^6.3.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "prisma": "^6.3.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
