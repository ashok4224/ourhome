{
  "name": "@ourhome/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --external:vite --external:http-proxy-middleware --sourcemap --outfile=dist/index.cjs",
    "start": "node dist/index.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@ourhome/shared": "*",
    "express": "^4.21.2",
    "http-proxy-middleware": "^3.0.3",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
