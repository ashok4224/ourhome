# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string. Required by every service that
# touches the database (all of them except the gateway).
# With the provided docker-compose.yml (`docker compose up -d`), use:
DATABASE_URL="postgresql://ourhome:ourhome@localhost:5432/ourhome"

# JWT_SECRET: random 64+ character string every service uses to sign/verify
# auth tokens. Required, and MUST be the same value across every service —
# auth-service signs with it, every other service verifies with it.
JWT_SECRET="MY_JWT_SECRET"

# INTERNAL_SERVICE_TOKEN: shared secret protecting service-to-service internal
# endpoints (currently just inquiries-service's /internal/inquiry-counts,
# called by properties-service). Required by both of those services.
INTERNAL_SERVICE_TOKEN="MY_INTERNAL_SERVICE_TOKEN"

# ── Per-service URLs (used by the gateway to route, and by services that call
# other services). Defaults below match local dev (`npm run dev`, everything
# on localhost). docker-compose.yml overrides these to compose service names.
AUTH_SERVICE_URL="http://localhost:4001"
PROPERTIES_SERVICE_URL="http://localhost:4002"
APPOINTMENTS_SERVICE_URL="http://localhost:4003"
INQUIRIES_SERVICE_URL="http://localhost:4004"
FAVORITES_SERVICE_URL="http://localhost:4005"
SUPPORT_SERVICE_URL="http://localhost:4006"
CHAT_SERVICE_URL="http://localhost:4007"

# ── Optional integration providers ─────────────────────────────────────
# All optional. Unset (or partially set) providers fall back to a noop
# implementation — see packages/shared/src/integrations/*/index.ts — so
# every feature remains testable without real vendor credentials.

# Payments (Razorpay) — both required together to enable the real provider.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# SMS / OTP (MSG91) — both required together to enable the real provider.
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# Maps / geolocation (Google Maps).
GOOGLE_MAPS_API_KEY=""
