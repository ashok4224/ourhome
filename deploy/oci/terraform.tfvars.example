# Copy to terraform.tfvars (gitignored) and fill in your real values.
# Find tenancy_ocid under Profile (top-right) > Tenancy in the OCI Console.

tenancy_ocid     = "ocid1.tenancy.oc1..aaaaaaaa..."
region           = "ap-hyderabad-1"
compartment_name = "ourhome"

# Defaults (node_shape = VM.Standard.A1.Flex, node_ocpus = 4,
# node_memory_gb = 24, node_pool_size = 1) already target the Always Free
# tier's entire ARM compute allocation on a single node — $0 compute cost.
# Nothing to override here unless you want to pay for x86_64 (VM.Standard.E4.Flex)
# instead — see node_shape's description in variables.tf.
